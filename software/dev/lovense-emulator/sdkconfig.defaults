# Lockbox sdkconfig.defaults — only non-default overrides
# ESP-IDF defaults apply for everything not listed here.

# --- Target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash: 16MB, 80MHz, QIO (quad flash on N16R8; not CONFIG_ESPTOOLPY_OCT_FLASH) ---
# CONFIG_ESPTOOLPY_OCT_FLASH is not set
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# --- PSRAM: octal/OPI for the Lockbox ESP32-S3-WROOM-1-N16R8 module ---
# SPIRAM_USE_MALLOC: malloc() prefers PSRAM for large allocations (see CONFIG_SPIRAM_USE).
# SPIRAM_IGNORE_NOTFOUND: boot continues if PSRAM init fails (bad wiring / wrong mode).
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- CPU: 240MHz ---
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# --- Logging: INFO default quiets MQTT_CLIENT / transport DEBUG spam ---
# LOG_MAXIMUM stays VERBOSE so esp_log_level_set() can re-enable per-tag debug.
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_MAXIMUM_LEVEL=5
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL=3

# --- FreeRTOS: Arduino requires 1000Hz tick ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# --- Disable application-level tracing (saves IRAM) ---
CONFIG_APPTRACE_DEST_NONE=y

# --- Bluetooth: controller-only; NimBLE-Arduino 2.4.0 supplies the host ---
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P9=y

# --- ESP-TLS: proper certificate validation ---
# CONFIG_ESP_TLS_INSECURE is not set
# CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY is not set

# --- Disable Ethernet (no hardware) ---
# CONFIG_ETH_ENABLED is not set

# --- Wi-Fi: tuned buffers, AMPDU, coex, 11kv ---
CONFIG_ESP32_WIFI_SW_COEXIST_ENABLE=y
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_TX_BA_WIN=16
CONFIG_ESP32_WIFI_RX_BA_WIN=16
CONFIG_ESP32_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# --- WPA supplicant: 802.11k/v for roaming ---
CONFIG_WPA_11KV_SUPPORT=y

# --- LWIP: tuned for always-on MQTT + HTTP ---
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_KEEP_CONNECTION_WHEN_IP_CHANGES=y
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_FALLBACK_DNS_SERVER_SUPPORT=y
CONFIG_LWIP_FALLBACK_DNS_SERVER_ADDRESS="8.8.8.8"

# --- mbedTLS: DEFAULT alloc (plain calloc -> SPIRAM policy), PSK required by WiFiClientSecure ---
# Measured 2026-08-25 with BLE resident: internal SRAM is ~72 KB free at boot; MQTTS holds
# ~35 KB of it for life, so the next HTTPS (is-paired) failed mbedTLS -32512 (alloc) and the
# box reported itself unpaired. DEFAULT_MEM_ALLOC routes blocks > SPIRAM_MALLOC_ALWAYSINTERNAL
# (the 16 KB TLS record in-buffer and the record out-buffer including overhead) to PSRAM
# with internal fallback, while the smaller SSL contexts and keys stay internal. NOT
# EXTERNAL_MEM_ALLOC: that is a hard
# MALLOC_CAP_SPIRAM with no fallback and would break TLS on boards whose PSRAM fails to init
# (SPIRAM_IGNORE_NOTFOUND). Trade-off: TLS record plaintext transits PSRAM (unencrypted
# without flash encryption); session keys do not. Keep in sync with sdkconfig.<env> (CI checks).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# Dynamic/variable buffers disabled — they corrupt the SSL context during long
# streaming reads (OTA), causing MBEDTLS_ERR_SSL_BAD_INPUT_DATA (-0x7100).
# The variable buffer starts small and fails to resize when the server sends
# a TLS record larger than the initial allocation.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
# CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH is not set
# Certificate bundle for proper TLS validation (OTA, HTTP).
# MQTT still uses its own hardcoded DigiCert cert.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=y

# --- MQTT: tuned buffers, skip publish when disconnected ---
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_BUFFER_SIZE=4096
CONFIG_MQTT_TASK_STACK_SIZE=6144
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=30000


# --- Task stack sizes reduced by ESP-IDF defaults vs Arduino ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
# --- Debug: precise stack overflow backtrace ---
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
